# Rust build output
/target
# The makepad UI-test driver pins the spawned editor's CARGO_TARGET_DIR here
/crates/waml-editor/target
# ...and the editor it spawns mints this scratch dir beside its manifest
/crates/waml-editor/.makepad
# ...and a screenshot query makes the spawned editor dump the raw framebuffer
# into its own cwd, which is that same manifest dir. 16 MB a shot -- the
# headless PNG encoder does not deflate. The driver copies the one it wants
# into the run artifacts; this is the leftover.
/crates/waml-editor/window_*_frame_*.png

# Node build output and caches
node_modules/
dist/
.pnpm-store/

# Python bytecode (tooling scripts)
__pycache__/

# Editor and IDE local state
# (.vscode/ is deliberately tracked: editors/vscode/.vscode/launch.json, lsp-demo/.vscode/settings.json)
.idea/
*.swp

# Local secrets
.env
.env.local

# Logs and OS cruft
*.log
.DS_Store
Thumbs.db

# Agent and tooling runtime state
.rtk/
.tokensave/
.superpowers/
.worktrees/

# .claude: track skills/workflows/scripts, ignore local runtime state
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/.headroom_wrap_marker.json

# rustc crash dumps, written into the cwd on an internal compiler error
rustc-ice-*.txt
