{
  "name": "waml-vscode",
  "private": true,
  "version": "0.0.0",
  "license": "MPL-2.0",
  "type": "commonjs",
  "displayName": "WAML",
  "description": "Live WAML diagnostics for Markdown documents.",
  "engines": {
    "vscode": "^1.91.0",
    "node": ">=20"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "contributes": {
    "configuration": {
      "title": "WAML",
      "properties": {
        "waml.serverPath": {
          "type": "string",
          "default": "waml",
          "description": "Path to the waml executable that provides the language server."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.91.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184"
}
