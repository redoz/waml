{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // vscode-languageclient 10 ships an `exports` map, which the legacy node10
    // resolver cannot read. `node18` resolves it; the package is
    // `"type": "commonjs"`, so the emit stays CommonJS either way.
    "module": "node18",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
